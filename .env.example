# Kopioi tiedostoksi .env.local paikalliseen kehitykseen. Älä koskaan commitoi oikeita arvoja.
# Tuotannossa arvot asetetaan Vercelin ympäristömuuttujiin (Project Settings > Environment Variables).

# Sivuston julkinen osoite (ilman loppukauttaviivaa)
NEXT_PUBLIC_SITE_URL=https://www.latente.fi

# Lomakkeen liidit lähetetään tähän osoitteeseen (CRM, Odoo, automaatio tai muu liidirekisteri)
LEAD_WEBHOOK_URL=
# Jaettu salaisuus (sama kuin Apps Scriptin SECRET). Lähetetään otsikossa X-Webhook-Secret ja sisällössä, koska Apps Script ei näe otsikoita
LEAD_WEBHOOK_SECRET=

# Google Analytics 4 -tunnus (muoto G-XXXXXXXXXX). Ladataan vain evästesuostumuksen jälkeen.
NEXT_PUBLIC_GA_ID=

# Kohdesivujen käyntitapahtumat (docs/kohdesivu-tapahtumat.md): Supabase (EU), Latenten oma projekti.
# Vercelin Supabase-integraatio lisää nämä itse. Ilman niitä tapahtumia ei tallenneta.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Valinnainen: skeema, jos tapahtumat ovat yhteisessä projektissa omassa skeemassaan (oletus public)
SUPABASE_TAPAHTUMA_SKEEMA=
# Latenten viennin avain (vähintään 32 satunnaista merkkiä), otsakkeessa Authorization: Bearer <avain>
VIENTI_AVAIN=
